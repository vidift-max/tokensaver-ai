{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tokensaver://schemas/provider-chat-request.json",
  "title": "Provider Gateway Chat Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["provider", "messages"],
  "properties": {
    "provider": {"enum": ["openai", "anthropic", "gemini", "kimi"]},
    "model": {"type": ["string", "null"], "maxLength": 128},
    "system": {"type": ["string", "null"], "maxLength": 1000000},
    "messages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "content"],
        "properties": {
          "role": {"enum": ["user", "assistant"]},
          "content": {"type": "string", "maxLength": 1000000}
        }
      }
    },
    "temperature": {"type": ["number", "null"], "minimum": 0, "maximum": 2},
    "max_output_tokens": {"type": ["integer", "null"], "minimum": 1, "maximum": 1000000},
    "stream": {"type": "boolean", "default": false}
  }
}
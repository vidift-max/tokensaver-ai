[
 uuid(4A2B0D37-9F21-4D2C-8B63-0F8B4D6A2C91),
 version(1.1),
 pointer_default(unique)
]
interface PhoneSupervisorRpc {
 void BeginSession([in] handle_t binding,[in,string] wchar_t* correlation_id,
  [out,string] wchar_t** session_id,[out,string] wchar_t** nonce,[out] long* status);
 void Authorize([in] handle_t binding,[in,string] wchar_t* correlation_id,
  [in,string] wchar_t* session_id,[in,string] wchar_t* nonce,[out] long* status);
 void Heartbeat([in] handle_t binding,[in,string] wchar_t* correlation_id,
  [in,string] wchar_t* session_id,[out] long* status);
 void CloseSession([in] handle_t binding,[in,string] wchar_t* correlation_id,
  [in,string] wchar_t* session_id,[out] long* status);
 // Fixed fake scenario uses only Supervisor-owned provisioned binding.
 // No AI_PHONE_ID, bearer, endpoint credential or sender identity crosses RPC.
 void TeamRoomScenario([in] handle_t binding,[in,string] wchar_t* correlation_id,
  [in,string] wchar_t* session_id,[out] long* status);
}

# First-contact server environment template.
# Copy to a deployment host as .env; never commit real values.

POSTGRES_DB=team_room
POSTGRES_USER=team_room
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_SECRET

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_SECRET

# Public DNS name that points to the server.
TEAM_ROOM_DOMAIN=room.example.com

# Keycloak issuer must match the externally reachable OIDC issuer.
OIDC_ISSUER=https://room.example.com/realms/team-room
OIDC_AUDIENCE=ai-team-room
OIDC_JWKS_URL=https://room.example.com/realms/team-room/protocol/openid-connect/certs
